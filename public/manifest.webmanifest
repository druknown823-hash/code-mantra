{
  "name": "LabVault",
  "short_name": "LabVault",
  "description": "Frictionless mobile-first collaborative code repository for lab assignments",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "categories": ["education", "developer tools", "productivity"],
  "icons": [
    {
      "src": "/vault-icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
