# LabVault Environment Configuration
# Copy this file to .env.local to configure your live Supabase project

# Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public Key (safe to expose in client)
# NEVER put your service_role secret key here!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
